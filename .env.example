# ═══════════════════════════════════════════════════════════════════════════
#  ATLAS — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  The map feeds use public keyless sources. Keys below are only for the
#  operations database, login, CCTV tokens, and optional upgrades.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  BACKENDS
# ─────────────────────────────────────────────────────────────────────────
# Entity resolution backend for /api/entity/expand.
# INTEL_URL=

# Umami website id. Unset, empty, or invalid sends nothing. This deployment
# has no analytics host, so a value here still does not send a request.
# UMAMI_WEBSITE_ID=

# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on 3000).
# Change this if 3000 is already taken on your host.
OSIRIS_PORT=3000

# Operational database for Kotamaops, login, and the operator dashboard.
# Bind is 127.0.0.1:5433. Set the password and secrets in .env, not in this file.
# Required by docker compose (it refuses to start without it). Use a URL-safe
# value such as `openssl rand -hex 24`: compose builds the in-stack DATABASE_URL from it.
OSIRIS_POSTGRES_PASSWORD=
# For tools on the host (npm run dev, prisma). Inside the compose stack the app
# uses osiris-postgres:5432 instead, whatever this says.
DATABASE_URL=postgresql://osiris:password@127.0.0.1:5433/osiris_ops
# At least 32 characters (openssl rand -hex 32). Shorter counts as unset and login is refused.
OPS_SESSION_SECRET=
# Bootstrap SUPER_ADMIN, created by the seed when missing (the osiris-migrate
# service runs it on every start). Required; password at least 10 characters.
OPS_ADMIN_USERNAME=
OPS_ADMIN_PASSWORD=

# Database backups (osiris-backup service): one pg_dump a day into BACKUP_PATH.
# Copy that directory to another machine too.
# BACKUP_PATH=./backups
# BACKUP_RETENTION_DAYS=14

# Password reset mail. Leave SMTP_HOST empty until a relay is available.
# The app does not claim a message was sent when these are unset.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=osiris@example.invalid
# Public origin used in reset links (scheme://host[:port], no path). Required for
# password reset: when unset or invalid no reset mail is sent (the request Host is never trusted).
# OPS_PUBLIC_URL=https://atlas.example.local:8443

# Jasa Marga JID layer token for toll CCTV, variable-message signs, and
# kilometre posts (shp:cctv_main, shp:vms, shp:cctv_gerbang, shp:batas_km,
# shp:cctv_ramp, shp:cctv_arteri, shp:cctv_ss, shp:cctv_pemantauan).
# shp:gerbang is not requested. Leave empty to hide the layer.
# The token is not sent to the browser.
JASAMARGA_WFS_TOKEN=

# e-Smarteye portal session for the Jakarta TPT CCTV release.
# Value is the access_token cookie only. Leave empty to hide that layer.
# The cookie is not sent to the browser.
TPT_CCTV_TOKEN=

# Comma-separated list of public Telegram channel usernames (no @) to scrape
# for the "Telegram OSINT" map layer. Overrides the curated default set.
# Channels must have web preview enabled (most well-known OSINT channels do).
# Default if unset:
#   osintdefender,insiderpaper,aljazeeraenglish,nexta_live,war_monitor
# OSIRIS_TELEGRAM_CHANNELS=

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

# Basemap tiles. Leave unset to fetch CARTO tiles through the app (/api/proxy-tiles).
# When users reach the site through the bundled nginx (osiris-cache, port 8080), set
# this so nginx serves tiles from its disk cache and Node never handles them:
# TILE_PROXY_PATH=/proxy/tiles

# Public read-only keys the city CCTV portals ship to every visitor (not secrets);
# fill from the portal's own client code. Without them, those two regions stay empty.
MEDAN_CLIENT_ID=
MEDAN_CLIENT_SECRET=
BANDARLAMPUNG_API_KEY=
